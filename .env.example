# Gemini CLI / Vertex
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Model lives at "global"; deploy regions stay us-central1.
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview

# Direct Gemini API fallback (only if Vertex unavailable)
# GEMINI_API_KEY=

# Nano Banana extension (image generation)
NANOBANANA_API_KEY=

# Firebase (frontend / backend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Agent endpoint switch (local vs deployed)
# local default
VITE_AGENT_ENDPOINT=http://localhost:8080
# deployed override (Agent Engine via Cloud Function proxy)
# VITE_AGENT_ENDPOINT=https://<region>-<project>.cloudfunctions.net/agentProxy

# Workshop metadata
WORKSHOP_NAME="Gemini CLI Zero-to-Hero"
WORKSHOP_DATE="2026-05-08"
